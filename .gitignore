# ── 安全：绝不提交 ──
*cookie*
*token*.txt
.env

# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── 编辑器 ──
.vscode/
.idea/
.DS_Store
